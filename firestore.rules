rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection Test Path
    match /test/connection {
      allow read: if true;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isBootstrapAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tiwary.kris@gmail.com' ||
        request.auth.token.email_verified == true && request.auth.token.email == 'tiwary.kris@gmail.com'
      );
    }
    function isAdmin() { 
      return isBootstrapAdmin() || (
             isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Users Collection
    match /users/{uid} {
      function isValidUser(data) {
        return data.uid is string && 
               data.email is string && 
               (data.points == null || data.points is number) && 
               (data.isAdmin == null || data.isAdmin is bool);
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn() && (isOwner(uid) || isAdmin()); 
      
      allow create: if isSignedIn() && isOwner(uid) && 
                    incoming().keys().hasAll(['uid', 'email', 'points', 'isAdmin']) &&
                    (incoming().email == 'tiwary.kris@gmail.com' ? incoming().isAdmin == true : incoming().isAdmin == false) &&
                    incoming().points == 0;

      allow update: if isOwner(uid) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['points', 'lastActiveAt', 'tasksCompleted', 'referralsCount', 'displayName', 'referralCode'])) ||
        (isBootstrapAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isAdmin'])) ||
        isAdmin()
      );
    }

    // Tasks Collection
    match /tasks/{taskId} {
      function isValidTask(data) {
        return data.keys().hasAll(['id', 'type', 'title', 'reward']) &&
               data.id is string && data.reward is number;
      }
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidTask(incoming());
    }

    // Claims Subcollection
    match /users/{uid}/claims/{claimId} {
      function isValidClaim(data) {
        return data.keys().hasAll(['userId', 'taskId', 'reward', 'claimedAt']) &&
               data.userId == uid && data.reward is number;
      }
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && 
                    (incoming().keys().hasAll(['userId', 'taskId', 'reward', 'claimedAt']) || incoming().keys().hasAll(['userId', 'taskId', 'reward', 'claimedAt', 'taskTitle', 'type'])) &&
                    incoming().userId == uid && incoming().reward is number &&
                    // Verify task exists
                    exists(/databases/$(database)/documents/tasks/$(incoming().taskId));
    }

    // Withdrawals Collection
    match /withdrawals/{withdrawalId} {
      function isValidWithdrawal(data) {
        return data.keys().hasAll(['userId', 'amount', 'method', 'address', 'status', 'createdAt']) &&
               data.userId is string && data.amount > 0 && data.status in ['PENDING', 'APPROVED', 'REJECTED'];
      }
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isOwner(incoming().userId) && 
                    incoming().status == 'PENDING' && 
                    isValidWithdrawal(incoming());
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }

    // Settings Collection
    match /settings/{docId} {
      allow read: if true; // Public read for captcha keys/maintenance (though secret keys shouldn't be here)
      allow write: if isAdmin();
    }

    // Ads Collection
    match /ads/{adId} {
      function isValidAd(data) {
        return data.keys().hasAll(['imageUrl', 'linkUrl', 'position', 'isActive']) &&
               data.imageUrl is string && data.linkUrl is string && 
               data.position in ['header', 'bottom', 'right', 'left'] &&
               data.isActive is bool;
      }
      allow read: if true; // Public can see ads
      allow write: if isAdmin();
    }

    // Link Sessions Collection
    match /link_sessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false; // Only server (Admin SDK) should write this
    }
  }
}
